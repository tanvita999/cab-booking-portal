generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("customer")
  createdAt DateTime @default(now())
}

model Driver {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  licenseNo   String   @unique
  experience  Int
  cabType     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}