generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("customer")
  createdAt DateTime @default(now())

  bookings  Booking[]
}

model Driver {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  licenseNo   String   @unique
  experience  Int
  cabType     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  cab         Cab?
  bookings    Booking[]
}

model Cab {
  id          Int      @id @default(autoincrement())
  vehicleNo   String   @unique
  model       String
  color       String
  seats       Int
  isAvailable Boolean  @default(true)

  driverId    Int      @unique
  driver       Driver   @relation(fields: [driverId], references: [id])

  createdAt   DateTime @default(now())

  bookings    Booking[]
}

model Booking {
  id          Int      @id @default(autoincrement())

  pickup      String
  destination String
  fare        Float
  status      String   @default("Pending")

  userId      Int
  driverId    Int
  cabId       Int

  user        User   @relation(fields: [userId], references: [id])
  driver      Driver @relation(fields: [driverId], references: [id])
  cab         Cab    @relation(fields: [cabId], references: [id])

  createdAt   DateTime @default(now())
}